{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "unicorn/prefer-add-event-listener": "off",
    "no-new": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "docs-site/build/**",
    "docs-site/.docusaurus/**"
  ]
}
