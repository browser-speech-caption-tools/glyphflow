{
  "name": "@enumura1/glyphflow",
  "version": "0.1.0",
  "description": "Browser Web Speech narration with smoothly wiping karaoke captions.",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": ["./dist/styles.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"examples/basic/**/*.{ts,css,html}\" tsup.config.ts eslint.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config examples/basic/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
